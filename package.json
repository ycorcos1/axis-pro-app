{
  "name": "axis-pro",
  "version": "0.1.0",
  "description": "Professional-grade, minimalist desktop video editor",
  "main": "dist/main/main/main.js",
  "scripts": {
    "dev": "npm run build:main && concurrently \"vite\" \"wait-on http://localhost:5173 && electron dist/main/main/main.js\"",
    "dev:vite": "vite",
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "tsc -p tsconfig.main.json && tsc -p tsconfig.preload.json",
    "build:renderer": "vite build",
    "pack:mac": "electron-builder --mac dmg",
    "pack:win": "electron-builder --win nsis",
    "build:mac": "npm run build && npm run pack:mac",
    "build:win": "npm run build && npm run pack:win"
  },
  "keywords": [
    "video-editor",
    "electron",
    "desktop"
  ],
  "author": "",
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@types/node": "^24.9.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.1",
    "electron": "^38.4.0",
    "electron-builder": "^26.0.12",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "wait-on": "^9.0.1"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  }
}
